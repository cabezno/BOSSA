/* SODA FUSION Theme for Bossa */
/* Ultra-Deep Blacks, Cyan Accents, Magenta Highlights */

* {
    background-color: #000000;
    color: #ffffff;
    border: none;
    font-family: "Segoe UI", "Helvetica Neue", sans-serif;
}

QMainWindow, QDialog, QDockWidget {
    background-color: #000000;
}

QDockWidget::title {
    background-color: #0a0a0a;
    padding: 6px;
    border-bottom: 1px solid #00e5ff;
    text-transform: uppercase;
    font-weight: bold;
    letter-spacing: 2px;
}

QMenuBar {
    background-color: #0a0a0a;
    border-bottom: 1px solid #111111;
}

QMenuBar::item {
    background-color: transparent;
    padding: 4px 10px;
}

QMenuBar::item:selected {
    background-color: #111111;
    color: #00e5ff;
}

QMenu {
    background-color: #0a0a0a;
    border: 1px solid #00e5ff;
    padding: 4px;
}

QMenu::item {
    padding: 6px 20px;
}

QMenu::item:selected {
    background-color: #00e5ff;
    color: #000000;
    border-radius: 2px;
}

QToolBar {
    background-color: #0a0a0a;
    border-bottom: 2px solid #111111;
    spacing: 4px;
}

QToolButton {
    background-color: transparent;
    border-radius: 4px;
    padding: 4px;
}

QToolButton:hover {
    background-color: #111111;
    border: 1px solid #00e5ff;
}

QToolButton:pressed, QToolButton:checked {
    background-color: #e040fb;
    color: #000000;
    border: 1px solid #e040fb;
}

QPushButton {
    background-color: #111111;
    color: #ffffff;
    border: 1px solid #00e5ff;
    padding: 6px 16px;
    border-radius: 4px;
    font-weight: bold;
    text-transform: uppercase;
}

QPushButton:hover {
    background-color: rgba(0, 229, 255, 0.1);
    border: 1px solid #e040fb;
    color: #e040fb;
}

QPushButton:pressed {
    background-color: #e040fb;
    color: #000000;
}

QLineEdit, QSpinBox, QDoubleSpinBox, QComboBox {
    background-color: #0a0a0a;
    border: 1px solid #111111;
    padding: 4px;
    border-radius: 2px;
    selection-background-color: #e040fb;
}

QLineEdit:focus, QSpinBox:focus, QDoubleSpinBox:focus, QComboBox:focus {
    border: 1px solid #00e5ff;
}

QScrollBar:vertical {
    border: none;
    background: #000000;
    width: 12px;
    margin: 0px;
}

QScrollBar::handle:vertical {
    background: #111111;
    min-height: 20px;
    border-radius: 6px;
    margin: 2px;
}

QScrollBar::handle:vertical:hover {
    background: #00e5ff;
}

QScrollBar:horizontal {
    border: none;
    background: #000000;
    height: 12px;
    margin: 0px;
}

QScrollBar::handle:horizontal {
    background: #111111;
    min-width: 20px;
    border-radius: 6px;
    margin: 2px;
}

QScrollBar::handle:horizontal:hover {
    background: #00e5ff;
}

QScrollBar::add-line, QScrollBar::sub-line {
    border: none;
    background: none;
}

QTreeView, QListView, QTableView {
    background-color: #000000;
    alternate-background-color: #0a0a0a;
    border: none;
    selection-background-color: rgba(0, 229, 255, 0.2);
    selection-color: #00e5ff;
}

QTreeView::item:selected, QListView::item:selected, QTableView::item:selected {
    background-color: rgba(224, 64, 251, 0.2);
    color: #e040fb;
    border-left: 3px solid #e040fb;
}

QHeaderView::section {
    background-color: #0a0a0a;
    color: #546e7a;
    padding: 4px;
    border: none;
    border-right: 1px solid #111111;
    font-weight: bold;
    text-transform: uppercase;
}

QSlider::groove:horizontal {
    border: 1px solid #111111;
    height: 4px;
    background: #0a0a0a;
    border-radius: 2px;
}

QSlider::sub-page:horizontal {
    background: #00e5ff;
    border-radius: 2px;
}

QSlider::handle:horizontal {
    background: #ffffff;
    border: 1px solid #00e5ff;
    width: 12px;
    margin-top: -4px;
    margin-bottom: -4px;
    border-radius: 6px;
}

QSlider::handle:horizontal:hover {
    background: #e040fb;
    border-color: #e040fb;
}

QTabWidget::pane {
    border: 1px solid #111111;
    background: #000000;
}

QTabBar::tab {
    background: #0a0a0a;
    color: #546e7a;
    padding: 8px 16px;
    border: 1px solid #111111;
    border-bottom: none;
    border-top-left-radius: 4px;
    border-top-right-radius: 4px;
}

QTabBar::tab:selected {
    background: #000000;
    color: #00e5ff;
    border-top: 2px solid #00e5ff;
}

QTabBar::tab:hover:!selected {
    background: #111111;
    color: #ffffff;
}

QProgressBar {
    border: 1px solid #111111;
    background-color: #0a0a0a;
    border-radius: 4px;
    text-align: center;
    color: white;
}

QProgressBar::chunk {
    background-color: #e040fb;
    border-radius: 3px;
}
