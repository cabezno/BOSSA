/* SODA FUSION Theme for Bossa */
/* Based on SODA Core Palette */

QMainWindow, QWidget {
    background-color: #000000; /* --soda-black */
    color: #ffffff; /* --soda-white */
}

/* Secondary areas / docks */
QDockWidget, QMenuBar, QToolBar, QStatusBar {
    background-color: #0a0a0a; /* --soda-surface */
    color: #ffffff;
    border: 1px solid #1a1a1a; /* --soda-border */
}

QMenuBar::item:selected {
    background-color: #1a1a1a;
    color: #00e5ff; /* --soda-cyan */
}

/* Inputs and Panels */
QLineEdit, QTextEdit, QPlainTextEdit, QComboBox, QAbstractItemView {
    background-color: #050505; /* --soda-input */
    color: #ffffff;
    border: 1px solid #1a1a1a;
    border-radius: 4px;
    selection-background-color: #e040fb; /* --soda-magenta */
    selection-color: #000000;
}

QLineEdit:focus {
    border: 1px solid #00e5ff; /* --soda-cyan accent */
}

/* Buttons */
QPushButton {
    background-color: #0a0a0a;
    color: #ffffff;
    border: 1px solid #1a1a1a;
    padding: 5px 15px;
    border-radius: 4px;
}

QPushButton:hover {
    background-color: #1a1a1a;
    border: 1px solid #00e5ff;
}

QPushButton:pressed {
    background-color: #e040fb;
    color: #000000;
}

/* Primary actions like 'Export' or 'Render' */
QPushButton#primaryAction {
    background-color: #e040fb;
    color: #000000;
    font-weight: bold;
}

/* Timeline and Scrollbars */
QScrollBar:vertical {
    border: none;
    background: #000000;
    width: 10px;
    margin: 0px;
}

QScrollBar::handle:vertical {
    background: #1a1a1a;
    min-height: 20px;
    border-radius: 5px;
}

QScrollBar::handle:vertical:hover {
    background: #00e5ff;
}

QScrollBar:horizontal {
    border: none;
    background: #000000;
    height: 10px;
    margin: 0px;
}

QScrollBar::handle:horizontal {
    background: #1a1a1a;
    min-width: 20px;
    border-radius: 5px;
}

QScrollBar::handle:horizontal:hover {
    background: #00e5ff;
}

/* Separators */
QMainWindow::separator {
    background-color: #1a1a1a;
    width: 2px;
    height: 2px;
}

QMainWindow::separator:hover {
    background-color: #00e5ff;
}

/* Labels and Muted text */
QLabel#mutedText {
    color: #546e7a; /* --soda-muted */
}

/* Specialized Headers */
QLabel#bmbHeader {
    font-family: 'Cinzel Decorative', 'Trajan Pro', serif;
    font-weight: 700;
    font-size: 18px;
    color: #00e5ff;
}
