/* SODA FUSION Theme for Bossa */
/* Deep Blacks & Vibrant Accents */

QMainWindow, QWidget {
    background-color: #000000; /* --soda-void */
    color: #ffffff; /* --soda-t1 */
}

/* Secondary areas / docks / surfaces */
QDockWidget, QMenuBar, QToolBar, QStatusBar {
    background-color: #0a0a0a; /* --soda-surface */
    color: #ffffff;
    border: 1px solid rgba(255, 255, 255, 0.05); /* --soda-border-dim */
}

QMenuBar::item:selected {
    background-color: #111111; /* --soda-raised */
    color: #00e5ff; /* --soda-cyan */
}

/* Inputs and Panels (Raised) */
QLineEdit, QTextEdit, QPlainTextEdit, QComboBox, QAbstractItemView {
    background-color: #111111; /* --soda-raised */
    color: #ffffff;
    border: 1px solid rgba(255, 255, 255, 0.05);
    border-radius: 4px;
    selection-background-color: #e040fb; /* --soda-magenta */
    selection-color: #000000;
}

QLineEdit:focus {
    border: 1px solid #00e5ff; /* --soda-cyan accent */
}

/* Buttons */
QPushButton {
    background-color: #111111;
    color: #ffffff;
    border: 1px solid rgba(255, 255, 255, 0.05);
    padding: 5px 15px;
    border-radius: 4px;
}

QPushButton:hover {
    background-color: #1a1a1a;
    border: 1px solid #00e5ff;
}

QPushButton:pressed {
    background-color: #e040fb;
    color: #000000;
}

/* Primary actions like 'Export' or 'Render' */
QPushButton#primaryAction {
    background-color: #e040fb;
    color: #000000;
    font-weight: bold;
}

/* Scrollbars (Deep SODA Style) */
QScrollBar:vertical {
    border: none;
    background: #000000;
    width: 10px;
    margin: 0px;
}

QScrollBar::handle:vertical {
    background: #111111;
    min-height: 20px;
    border-radius: 5px;
}

QScrollBar::handle:vertical:hover {
    background: #00e5ff;
}

QScrollBar:horizontal {
    border: none;
    background: #000000;
    height: 10px;
    margin: 0px;
}

QScrollBar::handle:horizontal {
    background: #111111;
    min-width: 20px;
    border-radius: 5px;
}

QScrollBar::handle:horizontal:hover {
    background: #00e5ff;
}

/* Separators */
QMainWindow::separator {
    background-color: rgba(255, 255, 255, 0.05);
    width: 2px;
    height: 2px;
}

QMainWindow::separator:hover {
    background-color: #00e5ff;
}

/* Labels and Muted text */
QLabel#mutedText {
    color: #546e7a; /* --soda-t3 */
}

QLabel#secondaryText {
    color: #b0bec5; /* --soda-t2 */
}

/* Specialized Headers */
QLabel#bmbHeader {
    font-family: 'Cinzel Decorative', 'Trajan Pro', serif;
    font-weight: 700;
    font-size: 18px;
    color: #00e5ff;
}
