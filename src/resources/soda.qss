/* SODA FUSION - Professional Master Stylesheet (Aggressive Overhaul) */
/* Target: High-End UI consistency (DaVinci/After Effects style) */

/* Global Palette */
* {
    background-color: #000000;
    color: #ffffff;
    border: none;
    font-family: "Segoe UI Variable Text", "Inter", "Helvetica Neue", sans-serif;
    font-size: 11px;
}

QMainWindow, QDialog, QDockWidget {
    background-color: #000000;
}

/* LEFT SIDEBAR - THE NEW ENGINE ROOM */
QToolBar#mainToolBar {
    background-color: #0a0a0a;
    border-right: 1px solid #1a1a1a;
    spacing: 0px;
    padding: 0px;
    min-width: 80px;
}

QToolBar#mainToolBar QToolButton {
    background-color: transparent;
    color: #546e7a;
    border: none;
    border-left: 3px solid transparent;
    padding: 15px 5px;
    width: 70px;
    text-align: center;
    text-transform: uppercase;
    font-weight: bold;
    font-size: 9px;
    letter-spacing: 1px;
}

QToolBar#mainToolBar QToolButton:hover {
    background-color: #111111;
    color: #00e5ff;
}

QToolBar#mainToolBar QToolButton:checked {
    background-color: #111111;
    color: #00e5ff;
    border-left: 3px solid #00e5ff;
}

/* TOP MONOLITHIC MENU */
QMenuBar {
    background-color: #000000;
    padding: 2px;
    border-bottom: 1px solid #1a1a1a;
}

QMenuBar::item {
    padding: 8px 15px;
    color: #546e7a;
    text-transform: uppercase;
    font-size: 10px;
    letter-spacing: 1px;
}

QMenuBar::item:selected {
    background-color: #111111;
    color: #00e5ff;
}

QMenu {
    background-color: #0a0a0a;
    border: 1px solid #1a1a1a;
    padding: 5px;
}

QMenu::item {
    padding: 8px 25px;
    border-radius: 4px;
}

QMenu::item:selected {
    background-color: #00e5ff;
    color: #000000;
}

/* PROFESSIONAL DOCK STYLING */
QDockWidget {
    titlebar-close-icon: none;
    titlebar-normal-icon: none;
    border: 1px solid #1a1a1a;
}

QDockWidget::title {
    background-color: #050505;
    padding: 10px;
    border-bottom: 1px solid #1a1a1a;
    text-align: left;
    text-transform: uppercase;
    letter-spacing: 1.5px;
    color: #00e5ff;
    font-weight: bold;
}

/* INPUT CONTROLS */
QLineEdit, QSpinBox, QDoubleSpinBox, QComboBox, QAbstractSpinBox {
    background-color: #0a0a0a;
    border: 1px solid #1a1a1a;
    border-radius: 2px;
    padding: 5px;
    color: #00e5ff;
}

QLineEdit:focus, QAbstractSpinBox:focus {
    border: 1px solid #e040fb;
    background-color: #111111;
}

/* SCROLLBARS (Modern/Minimal) */
QScrollBar:vertical {
    border: none;
    background: #000000;
    width: 4px;
    margin: 0px;
}

QScrollBar::handle:vertical {
    background: #1a1a1a;
    min-height: 30px;
    border-radius: 2px;
}

QScrollBar::handle:vertical:hover {
    background: #00e5ff;
}

QScrollBar:horizontal {
    border: none;
    background: #000000;
    height: 4px;
    margin: 0px;
}

QScrollBar::handle:horizontal {
    background: #1a1a1a;
    min-width: 30px;
    border-radius: 2px;
}

/* TIMELINE SPECIAL */
QAbstractScrollArea#timelineScrollArea {
    background-color: #000000;
    border-top: 2px solid #1a1a1a;
}

/* BUTTONS */
QPushButton {
    background-color: #111111;
    border: 1px solid #1a1a1a;
    border-radius: 4px;
    padding: 8px 20px;
    font-weight: bold;
    text-transform: uppercase;
    color: #ffffff;
}

QPushButton:hover {
    border: 1px solid #00e5ff;
    color: #00e5ff;
}

QPushButton:pressed {
    background-color: #e040fb;
    color: #000000;
    border: 1px solid #e040fb;
}

/* TAB BAR (Docks tabified) */
QTabBar::tab {
    background: #0a0a0a;
    color: #546e7a;
    padding: 10px 20px;
    border-right: 1px solid #1a1a1a;
    text-transform: uppercase;
    font-size: 9px;
}

QTabBar::tab:selected {
    background: #000000;
    color: #00e5ff;
    border-bottom: 2px solid #00e5ff;
}
