/* SODA FUSION Theme for Bossa */
/* Ultra-Deep Blacks, Cyan Accents, Magenta Highlights */

/* Global Defaults */
QWidget {
    background-color: #000000; /* --soda-void */
    color: #ffffff; /* --soda-white */
    font-family: 'Segoe UI', 'Inter', sans-serif;
    border: none;
}

/* Main Window & Docks */
QMainWindow {
    background-color: #000000;
}

QDockWidget {
    color: #00e5ff; /* Cyan headers */
    titlebar-close-icon: url(:/icons/dark/32x32/window-close.png);
    titlebar-normal-icon: url(:/icons/dark/32x32/view-refresh.png);
}

QDockWidget::title {
    background-color: #0a0a0a;
    padding-left: 10px;
    padding-top: 4px;
    font-weight: bold;
    text-transform: uppercase;
    letter-spacing: 1px;
}

/* Menus & Toolbars */
QMenuBar {
    background-color: #000000;
    border-bottom: 1px solid #111111;
}

QMenuBar::item:selected {
    background-color: #111111;
    color: #00e5ff;
}

QMenu {
    background-color: #0a0a0a;
    border: 1px solid #111111;
}

QMenu::item:selected {
    background-color: #e040fb; /* Magenta selection */
    color: #000000;
}

QToolBar {
    background-color: #050505;
    border-bottom: 1px solid #111111;
    spacing: 5px;
    padding: 3px;
}

/* Buttons (Aggressive SODA) */
QPushButton {
    background-color: #111111;
    color: #ffffff;
    border: 1px solid #1a1a1a;
    border-radius: 2px;
    padding: 6px 12px;
    font-weight: bold;
}

QPushButton:hover {
    border-color: #00e5ff;
    background-color: #151515;
}

QPushButton:pressed {
    background-color: #e040fb;
    color: #000000;
}

/* Specialized Buttons */
QPushButton#primaryAction {
    background-color: #e040fb;
    color: #000000;
}

/* Input Fields */
QLineEdit, QTextEdit, QPlainTextEdit, QComboBox {
    background-color: #050505;
    color: #ffffff;
    border: 1px solid #111111;
    border-radius: 2px;
    padding: 4px;
    selection-background-color: #e040fb;
    selection-color: #000000;
}

QLineEdit:focus, QComboBox:focus {
    border-color: #00e5ff;
}

/* Lists & Tables (Timeline/Playlist) */
QAbstractItemView {
    background-color: #050505;
    alternate-background-color: #0a0a0a;
    color: #ffffff;
    border: 1px solid #111111;
    gridline-color: #111111;
    selection-background-color: rgba(224, 64, 251, 100); /* Translucent Magenta */
}

/* Scrollbars - The "Ghost" Look */
QScrollBar:vertical {
    border: none;
    background: #000000;
    width: 8px;
}

QScrollBar::handle:vertical {
    background: #111111;
    min-height: 20px;
}

QScrollBar::handle:vertical:hover {
    background: #00e5ff;
}

QScrollBar:horizontal {
    border: none;
    background: #000000;
    height: 8px;
}

QScrollBar::handle:horizontal {
    background: #111111;
    min-width: 20px;
}

/* Headers */
QHeaderView::section {
    background-color: #0a0a0a;
    color: #b0bec5;
    padding: 4px;
    border: 1px solid #111111;
    font-weight: bold;
}

/* Labels */
QLabel#bmbHeader {
    font-family: 'Cinzel Decorative';
    font-size: 20px;
    color: #00e5ff;
    letter-spacing: 3px;
}

QLabel#mutedText {
    color: #546e7a;
}
