html,
body {
  margin: 0;
  padding: 0;
  width: 100%;
  height: 100%;
  display: table;
  background-color: transparent;
}

.container {
  display: table-cell;
  text-align: center;
  vertical-align: middle;
}

.soda-text {
  font-family: 'Cinzel Decorative', 'Trajan Pro', serif;
  font-weight: 700;
  font-size: 8vw;
  letter-spacing: 0.12em;
  background: linear-gradient(135deg, #00e5ff 0%, #f5d060 45%, #e040fb 100%);
  -webkit-background-clip: text;
  -webkit-text-fill-color: transparent;
  background-clip: text;
  text-transform: uppercase;
  animation: soda-pulse 3s ease-in-out infinite;
}

@keyframes soda-pulse {
  0%, 100% {
    filter: drop-shadow(0 0 1vw rgba(0, 229, 255, 0.5));
    transform: scale(1);
  }
  50% {
    filter: drop-shadow(0 0 2vw rgba(224, 64, 251, 0.8));
    transform: scale(1.02);
  }
}
